NEXT_PUBLIC_SITE_URL=https://lbernardo-dev.github.io/apps
NEXT_PUBLIC_BASE_PATH=/apps
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPPORT_EMAIL=hola@example.com

# What's New: proveedor gratuito por defecto. Amplía locales con una lista ISO
# separada por comas (por ejemplo: es,en,fr,de).
TRANSLATION_PROVIDER=mymemory
TRANSLATION_TARGET_LOCALES=es,en
LIBRETRANSLATE_URL=

# Proveedor de pago opcional si se selecciona explícitamente TRANSLATION_PROVIDER=openai.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Reseñas de App Store: por defecto recorre todos los storefronts configurados
# y hasta 10 páginas RSS por mercado. Se pueden acotar temporalmente para una
# ejecución manual usando códigos ISO separados por comas (por ejemplo: es,us,gb).
APP_STORE_REVIEW_MARKETS=
APP_STORE_REVIEW_PAGES=10

# Escrituras de onboarding/procesos (trailhead, changelog): NUNCA usar el anon key.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Marketplace AliExpress (opcional hasta contratar/activar la API de afiliados)
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=
ALIEXPRESS_ACCESS_TOKEN=
ALIEXPRESS_REGION=api-sg.aliexpress.com
ALIEXPRESS_ENDPOINT=rest
ALIEXPRESS_PRODUCT_IDS=
